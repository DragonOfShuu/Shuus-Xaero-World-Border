{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "request": "launch",
      "name": "Forge Client",
      "presentation": {
        "group": "Mod Development",
        "order": 0
      },
      "projectName": "forge",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@${workspaceFolder}/forge/build/moddev/clientRunProgramArgs.txt"
      ],
      "vmArgs": "@${workspaceFolder}/forge/build/moddev/clientRunVmArgs.txt",
      "env": {
        "MOD_CLASSES": "shuusxaerowb%%${workspaceFolder}/forge/build/classes/java/main:shuusxaerowb%%${workspaceFolder}/forge/build/resources/main"
      },
      "cwd": "${workspaceFolder}/forge/run",
      "console": "internalConsole",
      "shortenCommandLine": "none",
      "preLaunchTask": "gradle: forge classes"
    },
    {
      "type": "java",
      "request": "launch",
      "name": "Forge Server",
      "presentation": {
        "group": "Mod Development",
        "order": 1
      },
      "projectName": "forge",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@${workspaceFolder}/forge/build/moddev/serverRunProgramArgs.txt"
      ],
      "vmArgs": "@${workspaceFolder}/forge/build/moddev/serverRunVmArgs.txt",
      "env": {
        "MOD_CLASSES": "shuusxaerowb%%${workspaceFolder}/forge/build/classes/java/main:shuusxaerowb%%${workspaceFolder}/forge/build/resources/main"
      },
      "cwd": "${workspaceFolder}/forge/run",
      "console": "internalConsole",
      "shortenCommandLine": "none",
      "preLaunchTask": "gradle: forge classes"
    },
    {
      "type": "java",
      "request": "launch",
      "name": "Forge Data",
      "presentation": {
        "group": "Mod Development",
        "order": 2
      },
      "projectName": "forge",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@${workspaceFolder}/forge/build/moddev/dataRunProgramArgs.txt"
      ],
      "vmArgs": "@${workspaceFolder}/forge/build/moddev/dataRunVmArgs.txt",
      "env": {
        "MOD_CLASSES": "shuusxaerowb%%${workspaceFolder}/forge/build/classes/java/main:shuusxaerowb%%${workspaceFolder}/forge/build/resources/main"
      },
      "cwd": "${workspaceFolder}/forge/run",
      "console": "internalConsole",
      "shortenCommandLine": "none",
      "preLaunchTask": "gradle: forge classes"
    },
    {
      "type": "java",
      "request": "attach",
      "name": "Fabric Client (debug)",
      "presentation": {
        "group": "Mod Development",
        "order": 3
      },
      "hostName": "localhost",
      "port": 5005,
      "preLaunchTask": "fabric: runClient (debug)"
    },
    {
      "type": "java",
      "request": "attach",
      "name": "Fabric Server (debug)",
      "presentation": {
        "group": "Mod Development",
        "order": 4
      },
      "hostName": "localhost",
      "port": 5005,
      "preLaunchTask": "fabric: runServer (debug)"
    }
  ]
}